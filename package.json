{
  "name": "scalesight-alecs-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "pnpm test && node scripts/production.mjs build",
    "start": "node scripts/production.mjs start",
    "lint": "eslint",
    "test": "tsc -p tsconfig.tests.json && node .test-build/tests/alecs.test.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts/generate-panel.ts tests/alecs.test.ts tests/browser/alecs.spec.ts README.md playwright.config.ts",
    "test:production": "node tests/production-lifecycle.mjs",
    "generate:panel": "tsc -p tsconfig.tests.json && node .test-build/scripts/generate-panel.js"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}
